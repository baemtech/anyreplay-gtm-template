___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// AnyReplay for Google Tag Manager.
//
// This does what the AnyReplay script tag does, inside the sandbox: it defines
// window.anyreplay as a function that queues its calls, queues 'init' with the
// options from the fields above, and loads the recorder from the CDN. The
// recorder replays the queue when it arrives, so nothing races.

const addConsentListener = require('addConsentListener');
const callInWindow = require('callInWindow');
const copyFromWindow = require('copyFromWindow');
const createArgumentsQueue = require('createArgumentsQueue');
const encodeUriComponent = require('encodeUriComponent');
const getType = require('getType');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const logToConsole = require('logToConsole');
const makeInteger = require('makeInteger');
const makeNumber = require('makeNumber');

const CDN_URL = 'https://cdn.anyreplay.com/v1/ar.min.js';
const DEFAULT_INGEST_URL = 'https://in.anyreplay.com';
const MAX_SESSION_CAP = 1000000;

// The sandbox has no regular expressions, so this is the field validator's
// pattern spelled out: ar_pk_live_ or ar_pk_test_, then 24 hex characters.
const HEX = '0123456789abcdef';
const isProjectKey = (key) => {
  if (getType(key) !== 'string' || key.length !== 35) return false;
  const prefix = key.substring(0, 11);
  if (prefix !== 'ar_pk_live_' && prefix !== 'ar_pk_test_') return false;
  for (let i = 11; i < 35; i++) {
    if (HEX.indexOf(key.charAt(i)) < 0) return false;
  }
  return true;
};

const isBlank = (value) => value === undefined || value === null || value === '';

const buildOptions = () => {
  const options = {
    projectKey: data.projectKey,
    ingestUrl: isBlank(data.ingestUrl) ? DEFAULT_INGEST_URL : data.ingestUrl,
  };

  // Only a real true turns masking on, the same rule the recorder applies.
  if (data.maskAllInputs === true) options.maskAllInputs = true;
  if (data.maskAllTyping === true) options.maskAllTyping = true;
  if (data.waitForConsent === true) options.requireConsent = true;
  if (data.debug === true) options.debug = true;

  if (!isBlank(data.sampleRate)) {
    const rate = makeNumber(data.sampleRate);
    if (rate >= 0 && rate <= 1) options.sampleRate = rate;
    else logToConsole('[anyreplay] Sample rate ignored: expected a number between 0 and 1.');
  }

  if (!isBlank(data.sessionCap)) {
    const cap = makeInteger(data.sessionCap);
    if (cap >= 1 && cap <= MAX_SESSION_CAP) options.maxSessionsPerMonth = cap;
    else logToConsole('[anyreplay] Monthly session cap ignored: expected a whole number between 1 and 1000000.');
  }

  return options;
};

const watchConsent = (consentType) => {
  // Granted already: start now. Either way, follow later changes, so a
  // visitor who withdraws consent stops being recorded on this page too.
  if (isConsentGranted(consentType)) callInWindow('anyreplay', 'consent', true);
  addConsentListener(consentType, (type, granted) => {
    callInWindow('anyreplay', 'consent', granted === true);
  });
};

const main = () => {
  if (!isProjectKey(data.projectKey)) {
    logToConsole('[anyreplay] Project key looks wrong. Copy it from your project\'s setup page in AnyReplay.');
    data.gtmOnFailure();
    return;
  }

  // Keep a recorder that is already on the page (a second tag, or the plain
  // snippet): its queue or its real function stays, and a second 'init' is
  // ignored by the recorder.
  if (getType(copyFromWindow('anyreplay')) !== 'function') {
    createArgumentsQueue('anyreplay', 'anyreplay.q');
  }

  callInWindow('anyreplay', 'init', buildOptions());

  if (data.waitForConsent === true) {
    watchConsent(isBlank(data.consentType) ? 'analytics_storage' : data.consentType);
  }

  injectScript(
    CDN_URL + '?k=' + encodeUriComponent(data.projectKey),
    data.gtmOnSuccess,
    data.gtmOnFailure,
    'anyreplay-recorder'
  );
};

main();


