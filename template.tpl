___TESTS___

scenarios:
- name: Queues init and loads the recorder with the key in the URL
  code: |-
    runCode(baseData);

    assertApi('createArgumentsQueue').wasCalledWith('anyreplay', 'anyreplay.q');
    assertApi('callInWindow').wasCalledWith('anyreplay', 'init', {
      projectKey: KEY,
      ingestUrl: 'https://in.anyreplay.com',
    });
    assertThat(injectedUrl).isEqualTo('https://cdn.anyreplay.com/v1/ar.min.js?k=' + KEY);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Refuses a key that is not an AnyReplay project key
  code: |-
    runCode({projectKey: 'ar_pk_live_XYZ', ingestUrl: 'https://in.anyreplay.com'});

    assertApi('injectScript').wasNotCalled();
    assertApi('callInWindow').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Passes masking, sampling, the cap and a custom ingest URL
  code: |-
    runCode({
      projectKey: KEY,
      ingestUrl: 'https://replay.example.com',
      maskAllInputs: true,
      maskAllTyping: true,
      sampleRate: '0.25',
      sessionCap: '5000',
      debug: true,
    });

    assertApi('callInWindow').wasCalledWith('anyreplay', 'init', {
      projectKey: KEY,
      ingestUrl: 'https://replay.example.com',
      maskAllInputs: true,
      maskAllTyping: true,
      debug: true,
      sampleRate: 0.25,
      maxSessionsPerMonth: 5000,
    });
- name: Ignores a sample rate and a cap out of range
  code: |-
    runCode({projectKey: KEY, ingestUrl: '', sampleRate: '2', sessionCap: '0'});

    assertApi('callInWindow').wasCalledWith('anyreplay', 'init', {
      projectKey: KEY,
      ingestUrl: 'https://in.anyreplay.com',
    });
    assertApi('gtmOnSuccess').wasCalled();
- name: Waits for consent and starts when it is already granted
  code: |-
    granted = true;
    runCode({projectKey: KEY, ingestUrl: 'https://in.anyreplay.com', waitForConsent: true, consentType: 'analytics_storage'});

    assertApi('callInWindow').wasCalledWith('anyreplay', 'init', {
      projectKey: KEY,
      ingestUrl: 'https://in.anyreplay.com',
      requireConsent: true,
    });
    assertApi('callInWindow').wasCalledWith('anyreplay', 'consent', true);
    assertApi('addConsentListener').wasCalled();
- name: Waits for consent and follows a later change
  code: |-
    granted = false;
    runCode({projectKey: KEY, ingestUrl: 'https://in.anyreplay.com', waitForConsent: true, consentType: 'analytics_storage'});

    assertApi('callInWindow').wasNotCalledWith('anyreplay', 'consent', true);
    consentListener('analytics_storage', true);
    assertApi('callInWindow').wasCalledWith('anyreplay', 'consent', true);
    consentListener('analytics_storage', false);
    assertApi('callInWindow').wasCalledWith('anyreplay', 'consent', false);
- name: Keeps a recorder that is already on the page
  code: |-
    existing = function () {};
    runCode(baseData);

    assertApi('createArgumentsQueue').wasNotCalled();
    assertApi('callInWindow').wasCalledWith('anyreplay', 'init', {
      projectKey: KEY,
      ingestUrl: 'https://in.anyreplay.com',
    });
setup: |-
  const KEY = 'ar_pk_test_0123456789abcdef01234567';
  const baseData = {projectKey: KEY, ingestUrl: 'https://in.anyreplay.com'};

  let injectedUrl;
  let granted = false;
  let consentListener;
  let existing;

  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injectedUrl = url;
    onSuccess();
  });
  mock('copyFromWindow', (key) => existing);
  mock('createArgumentsQueue', (fnKey, arrayKey) => function () {});
  mock('callInWindow', (path, command, value) => undefined);
  mock('isConsentGranted', (type) => granted);
  mock('addConsentListener', (type, listener) => {
    consentListener = listener;
  });


